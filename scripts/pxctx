#!/usr/bin/env python3
"""
scripts/pxctx — Python entry point shim for pxctx.

Adds docs/KB/ to PYTHONPATH and delegates to Vector_RAG.pxctx (Click CLI).

Usage::
  python scripts/pxctx <command> [options]
  python scripts/pxctx --help

Or use the repo-root bash wrapper (which handles venv activation)::
  ./pxctx <command>

Commands: add | query | promote | supersede | gc | compact | ingest | stats |
          get | list | session-new | session-update
"""

import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).parent.parent
_KB_DIR    = _REPO_ROOT / "docs" / "KB"

if str(_KB_DIR) not in sys.path:
    sys.path.insert(0, str(_KB_DIR))

from Vector_RAG.pxctx import cli  # noqa: E402

if __name__ == "__main__":
    cli()
import json
import math
import os
import re
import sqlite3
import sys
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

REPO_ROOT = Path(os.environ.get("PXCTX_ROOT", Path(__file__).parent.parent))
STORE_DIR = REPO_ROOT / ".pxctx"
DB_PATH = STORE_DIR / "store.db"
KB_ROOT = REPO_ROOT / "docs" / "KB"

TIERS = ("treasure", "working", "long-lived")
TIER_PRIORITY = {"treasure": 0, "working": 1, "long-lived": 2}

DEFAULT_BUDGET_TOKENS = 6000
AVG_CHARS_PER_TOKEN = 4  # rough estimate

# ---------------------------------------------------------------------------
# DB bootstrap
# ---------------------------------------------------------------------------

SCHEMA = """
CREATE TABLE IF NOT EXISTS docs (
    id             TEXT PRIMARY KEY,
    tier           TEXT NOT NULL CHECK(tier IN ('treasure','working','long-lived')),
    scope          TEXT NOT NULL DEFAULT 'repo',   -- repo | session | task
    type           TEXT NOT NULL DEFAULT 'note',   -- note|finding|decision|constraint|architecture|command_summary|kb-note
    tags           TEXT NOT NULL DEFAULT '[]',     -- JSON array
    sources        TEXT NOT NULL DEFAULT '[]',     -- JSON array
    pin            INTEGER NOT NULL DEFAULT 0,     -- bool
    ttl_days       REAL,                           -- NULL = no TTL
    never_expire   INTEGER NOT NULL DEFAULT 0,     -- bool
    supersedes     TEXT,                           -- doc id this supersedes
    superseded_by  TEXT,                           -- doc id that supersedes this
    verified       INTEGER NOT NULL DEFAULT 0,     -- bool
    created_at     TEXT NOT NULL,
    updated_at     TEXT NOT NULL,
    session_id     TEXT,
    task_id        TEXT,
    repo_id        TEXT,
    text           TEXT NOT NULL DEFAULT '',
    summary        TEXT,
    embedding_json TEXT                            -- JSON array of floats, if available
);

CREATE VIRTUAL TABLE IF NOT EXISTS docs_fts USING fts5(
    id UNINDEXED,
    text,
    summary,
    tags,
    type,
    content='docs',
    content_rowid='rowid'
);

CREATE TRIGGER IF NOT EXISTS docs_ai AFTER INSERT ON docs BEGIN
  INSERT INTO docs_fts(rowid, id, text, summary, tags, type)
  VALUES (new.rowid, new.id, new.text, COALESCE(new.summary,''), new.tags, new.type);
END;

CREATE TRIGGER IF NOT EXISTS docs_ad AFTER DELETE ON docs BEGIN
  INSERT INTO docs_fts(docs_fts, rowid, id, text, summary, tags, type)
  VALUES('delete', old.rowid, old.id, old.text, COALESCE(old.summary,''), old.tags, old.type);
END;

CREATE TRIGGER IF NOT EXISTS docs_au AFTER UPDATE ON docs BEGIN
  INSERT INTO docs_fts(docs_fts, rowid, id, text, summary, tags, type)
  VALUES('delete', old.rowid, old.id, old.text, COALESCE(old.summary,''), old.tags, old.type);
  INSERT INTO docs_fts(rowid, id, text, summary, tags, type)
  VALUES (new.rowid, new.id, new.text, COALESCE(new.summary,''), new.tags, new.type);
END;

CREATE TABLE IF NOT EXISTS sessions (
    session_id  TEXT PRIMARY KEY,
    repo_id     TEXT,
    task_id     TEXT,
    description TEXT,
    created_at  TEXT NOT NULL,
    updated_at  TEXT NOT NULL,
    state       TEXT NOT NULL DEFAULT 'active'  -- active | wrapped
);
"""


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def get_db() -> sqlite3.Connection:
    STORE_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys=ON")
    for statement in SCHEMA.split(";"):
        s = statement.strip()
        if s:
            try:
                conn.execute(s)
            except sqlite3.OperationalError:
                pass  # table/trigger already exists
    conn.commit()
    return conn


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def make_id(prefix: str = "doc") -> str:
    return f"{prefix}:{uuid.uuid4().hex[:12]}"


def repo_id_for(root: Path) -> str:
    return "repo:" + hashlib.sha1(str(root).encode()).hexdigest()[:8]


def row_to_dict(row: sqlite3.Row) -> dict:
    d = dict(row)
    for field in ("tags", "sources"):
        if isinstance(d.get(field), str):
            try:
                d[field] = json.loads(d[field])
            except Exception:
                d[field] = []
    return d


def estimate_tokens(text: str) -> int:
    return max(1, len(text) // AVG_CHARS_PER_TOKEN)


def score_keyword(query: str, text: str) -> float:
    """Very simple tf-style keyword overlap score, 0–1."""
    if not query or not text:
        return 0.0
    q_tokens = set(re.findall(r'\w+', query.lower()))
    t_tokens = re.findall(r'\w+', text.lower())
    if not t_tokens:
        return 0.0
    hits = sum(1 for t in t_tokens if t in q_tokens)
    return hits / (math.log(len(t_tokens) + 1) + 1)


def snippet(text: str, max_chars: int = 300) -> str:
    text = text.strip()
    if len(text) <= max_chars:
        return text
    return text[:max_chars] + "…"


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_add(args: argparse.Namespace) -> None:
    tier = args.tier
    if tier not in TIERS:
        sys.exit(f"ERROR: --tier must be one of: {', '.join(TIERS)}")

    text = args.text or ""
    if args.file:
        p = Path(args.file)
        if not p.exists():
            sys.exit(f"ERROR: file not found: {args.file}")
        text = p.read_text(encoding="utf-8")

    if not text.strip():
        sys.exit("ERROR: provide --text or --file")

    doc_id = make_id("doc")
    tags = args.tags or []
    sources = args.sources or []
    scope = args.scope or ("session" if tier == "working" else "repo")
    ttl_days = args.ttl_days
    never_expire = bool(args.never_expire or tier == "treasure")

    with get_db() as conn:
        conn.execute(
            """
            INSERT INTO docs
              (id, tier, scope, type, tags, sources, pin, ttl_days, never_expire,
               verified, created_at, updated_at, session_id, task_id, repo_id, text, summary)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (
                doc_id, tier, scope, args.type or "note",
                json.dumps(tags), json.dumps(sources),
                int(bool(args.pin)), ttl_days, int(never_expire),
                0, now_iso(), now_iso(),
                os.environ.get("PXCTX_SESSION_ID"),
                os.environ.get("PXCTX_TASK_ID"),
                repo_id_for(REPO_ROOT),
                text, args.summary,
            ),
        )
    print(json.dumps({"ok": True, "id": doc_id, "tier": tier}))


def cmd_query(args: argparse.Namespace) -> None:
    query = args.query_text or ""
    budget_tokens = args.budget or DEFAULT_BUDGET_TOKENS
    budget_chars = budget_tokens * AVG_CHARS_PER_TOKEN

    conn = get_db()

    # FTS search (all tiers)
    fts_ids: dict[str, float] = {}
    if query.strip():
        try:
            fq = " OR ".join(f'"{w}"' for w in re.findall(r'\w+', query) if len(w) > 2)
            if fq:
                rows = conn.execute(
                    "SELECT id, rank FROM docs_fts WHERE docs_fts MATCH ? ORDER BY rank LIMIT 40",
                    (fq,)
                ).fetchall()
                for r in rows:
                    # FTS rank is negative (lower = better), normalise to 0–1
                    fts_ids[r["id"]] = max(0.0, -r["rank"] / 10.0)
        except Exception:
            pass

    # Fetch all non-superseded, non-expired docs
    today = datetime.now(timezone.utc)
    all_docs = conn.execute(
        "SELECT * FROM docs WHERE superseded_by IS NULL ORDER BY created_at DESC"
    ).fetchall()

    eligible = []
    for row in all_docs:
        d = row_to_dict(row)
        # TTL filter
        if not d["never_expire"] and d["ttl_days"] is not None:
            created = datetime.fromisoformat(d["created_at"])
            if today > created + timedelta(days=d["ttl_days"]):
                continue
        # Score
        fts_score = fts_ids.get(d["id"], 0.0)
        kw_score = score_keyword(query, (d["text"] or "") + " " + (d["summary"] or ""))
        tier_boost = {0: 10.0, 1: 5.0, 2: 2.0}[TIER_PRIORITY[d["tier"]]]
        d["_score"] = tier_boost + fts_score + kw_score
        eligible.append(d)

    # Sort: always treasure first, then by score
    eligible.sort(key=lambda d: (-TIER_PRIORITY.get(d["tier"], 9) * 0 + d["_score"]), reverse=True)
    # Hard-enforce tier ordering: treasure always before working always before long-lived
    tier_order = {"treasure": 0, "working": 1, "long-lived": 2}
    eligible.sort(key=lambda d: (tier_order[d["tier"]], -d["_score"]))

    packs: dict[str, list] = {"treasure": [], "working": [], "long_lived": []}
    final: list[dict] = []
    used_chars = 0

    tier_key_map = {"treasure": "treasure", "working": "working", "long-lived": "long_lived"}

    for d in eligible:
        if used_chars >= budget_chars:
            break
        text_body = d["text"] or d["summary"] or ""
        chars = len(text_body)
        if used_chars + chars > budget_chars and d["tier"] != "treasure":
            # Skip non-treasure items that would exceed budget
            continue
        pack_entry = {
            "id": d["id"],
            "tier": d["tier"],
            "type": d["type"],
            "tags": d["tags"],
            "sources": d["sources"],
            "created_at": d["created_at"],
            "score": round(d["_score"], 3),
            "snippet": snippet(text_body),
        }
        packs[tier_key_map[d["tier"]]].append(pack_entry)
        final.append(pack_entry)
        used_chars += chars

    output = {
        "query": query,
        "budget_tokens": budget_tokens,
        "packs": packs,
        "final": final,
        "stats": {
            "total_eligible": len(eligible),
            "returned": len(final),
            "budget_used_chars": used_chars,
            "budget_total_chars": budget_chars,
        },
    }
    print(json.dumps(output, indent=2))


def cmd_promote(args: argparse.Namespace) -> None:
    doc_id = args.doc_id
    with get_db() as conn:
        row = conn.execute("SELECT * FROM docs WHERE id=?", (doc_id,)).fetchone()
        if not row:
            sys.exit(f"ERROR: doc not found: {doc_id}")
        d = row_to_dict(row)
        if d["tier"] == "treasure":
            print(json.dumps({"ok": True, "message": "Doc is already Treasure", "id": doc_id}))
            return
        conn.execute(
            "UPDATE docs SET tier='treasure', never_expire=1, ttl_days=NULL, pin=1, updated_at=? WHERE id=?",
            (now_iso(), doc_id)
        )
    print(json.dumps({"ok": True, "promoted": doc_id, "tier": "treasure"}))


def cmd_supersede(args: argparse.Namespace) -> None:
    old_id, new_id = args.old_id, args.new_id
    with get_db() as conn:
        old = conn.execute("SELECT * FROM docs WHERE id=?", (old_id,)).fetchone()
        new = conn.execute("SELECT * FROM docs WHERE id=?", (new_id,)).fetchone()
        if not old:
            sys.exit(f"ERROR: old doc not found: {old_id}")
        if not new:
            sys.exit(f"ERROR: new doc not found: {new_id}")
        conn.execute(
            "UPDATE docs SET superseded_by=?, updated_at=? WHERE id=?",
            (new_id, now_iso(), old_id)
        )
        conn.execute(
            "UPDATE docs SET supersedes=?, updated_at=? WHERE id=?",
            (old_id, now_iso(), new_id)
        )
    print(json.dumps({"ok": True, "superseded": old_id, "by": new_id}))


def cmd_gc(args: argparse.Namespace) -> None:
    today = datetime.now(timezone.utc)
    conn = get_db()
    all_docs = conn.execute(
        "SELECT id, created_at, ttl_days, never_expire, tier FROM docs WHERE never_expire=0 AND ttl_days IS NOT NULL"
    ).fetchall()

    to_delete = []
    for row in all_docs:
        created = datetime.fromisoformat(row["created_at"])
        if today > created + timedelta(days=row["ttl_days"]):
            to_delete.append(row["id"])

    if args.dry_run:
        print(json.dumps({"dry_run": True, "would_delete": to_delete}))
        return

    with conn:
        for doc_id in to_delete:
            conn.execute("DELETE FROM docs WHERE id=?", (doc_id,))

    print(json.dumps({"ok": True, "deleted": to_delete, "count": len(to_delete)}))


def cmd_compact(args: argparse.Namespace) -> None:
    """Summarise many Working items into a single Long-lived note."""
    session_id = args.session or os.environ.get("PXCTX_SESSION_ID")
    if not session_id:
        sys.exit("ERROR: provide --session or set PXCTX_SESSION_ID")

    conn = get_db()
    rows = conn.execute(
        "SELECT * FROM docs WHERE tier='working' AND session_id=? AND superseded_by IS NULL",
        (session_id,)
    ).fetchall()

    if not rows:
        print(json.dumps({"ok": True, "message": "No working docs to compact", "session_id": session_id}))
        return

    combined = "\n\n---\n\n".join(
        f"## [{row_to_dict(r)['type']}] {row_to_dict(r)['id']}\n\n{row_to_dict(r)['text']}" for r in rows
    )
    summary_text = f"Compacted {len(rows)} working items from session {session_id}.\n\n" + combined

    new_id = make_id("doc")
    with get_db() as wconn:
        wconn.execute(
            """
            INSERT INTO docs
              (id, tier, scope, type, tags, sources, pin, never_expire,
               verified, created_at, updated_at, session_id, repo_id, text, summary)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (
                new_id, "long-lived", "repo", "distilled-note",
                json.dumps(["compacted", f"session:{session_id}"]), json.dumps([]),
                0, 0, 0, now_iso(), now_iso(),
                session_id, repo_id_for(REPO_ROOT),
                summary_text,
                f"Compacted note from session {session_id} ({len(rows)} items)",
            )
        )
        # Mark originals as superseded by the compact note
        for r in rows:
            wconn.execute(
                "UPDATE docs SET superseded_by=?, updated_at=? WHERE id=?",
                (new_id, now_iso(), r["id"])
            )

    print(json.dumps({
        "ok": True, "compacted_id": new_id, "source_count": len(rows),
        "session_id": session_id
    }))


def cmd_status(args: argparse.Namespace) -> None:
    conn = get_db()
    by_tier = conn.execute(
        "SELECT tier, COUNT(*) as cnt FROM docs WHERE superseded_by IS NULL GROUP BY tier"
    ).fetchall()
    sessions = conn.execute(
        "SELECT session_id, description, state, created_at FROM sessions ORDER BY created_at DESC LIMIT 5"
    ).fetchall()
    result = {
        "db": str(DB_PATH),
        "docs_by_tier": {r["tier"]: r["cnt"] for r in by_tier},
        "recent_sessions": [dict(s) for s in sessions],
    }
    print(json.dumps(result, indent=2))


def cmd_get(args: argparse.Namespace) -> None:
    conn = get_db()
    row = conn.execute("SELECT * FROM docs WHERE id=?", (args.doc_id,)).fetchone()
    if not row:
        sys.exit(f"ERROR: doc not found: {args.doc_id}")
    print(json.dumps(row_to_dict(row), indent=2))


def cmd_list(args: argparse.Namespace) -> None:
    conn = get_db()
    query = "SELECT id, tier, type, tags, summary, created_at, session_id FROM docs WHERE superseded_by IS NULL"
    params: list[Any] = []
    if args.tier:
        query += " AND tier=?"
        params.append(args.tier)
    if args.session:
        query += " AND session_id=?"
        params.append(args.session)
    query += " ORDER BY created_at DESC LIMIT 50"
    rows = conn.execute(query, params).fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try:
            d["tags"] = json.loads(d["tags"])
        except Exception:
            pass
        result.append(d)
    print(json.dumps(result, indent=2))


def cmd_session_new(args: argparse.Namespace) -> None:
    session_id = make_id("sess")
    task_id = make_id("task")
    repo = repo_id_for(REPO_ROOT)
    desc = args.description or ""
    with get_db() as conn:
        conn.execute(
            "INSERT INTO sessions (session_id, repo_id, task_id, description, created_at, updated_at) VALUES (?,?,?,?,?,?)",
            (session_id, repo, task_id, desc, now_iso(), now_iso())
        )
    result = {"session_id": session_id, "task_id": task_id, "repo_id": repo, "description": desc}
    print(json.dumps(result))


def cmd_session_update(args: argparse.Namespace) -> None:
    session_id = args.session_id or os.environ.get("PXCTX_SESSION_ID")
    if not session_id:
        sys.exit("ERROR: provide --session-id or set PXCTX_SESSION_ID")
    with get_db() as conn:
        if args.state:
            conn.execute(
                "UPDATE sessions SET state=?, updated_at=? WHERE session_id=?",
                (args.state, now_iso(), session_id)
            )
        if args.description:
            conn.execute(
                "UPDATE sessions SET description=?, updated_at=? WHERE session_id=?",
                (args.description, now_iso(), session_id)
            )
    print(json.dumps({"ok": True, "session_id": session_id}))


# ---------------------------------------------------------------------------
# CLI wiring
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="pxctx",
        description="Professor X Context Management CLI — 3-tier RAG system",
    )
    sub = p.add_subparsers(dest="command", required=True)

    # add
    add_p = sub.add_parser("add", help="Add a context item")
    add_p.add_argument("--tier", required=True, choices=TIERS)
    add_p.add_argument("--type", default="note")
    add_p.add_argument("--text", default="")
    add_p.add_argument("--file", help="Read text from file")
    add_p.add_argument("--summary", default=None)
    add_p.add_argument("--tags", nargs="*", default=[])
    add_p.add_argument("--sources", nargs="*", default=[])
    add_p.add_argument("--scope", default=None)
    add_p.add_argument("--ttl-days", dest="ttl_days", type=float, default=None)
    add_p.add_argument("--never-expire", dest="never_expire", action="store_true")
    add_p.add_argument("--pin", action="store_true")
    add_p.set_defaults(func=cmd_add)

    # query
    q_p = sub.add_parser("query", help="Retrieve context for a query")
    q_p.add_argument("query_text", nargs="?", default="")
    q_p.add_argument("--budget", type=int, default=DEFAULT_BUDGET_TOKENS, help="Token budget")
    q_p.add_argument("--json", dest="json_output", action="store_true")
    q_p.set_defaults(func=cmd_query)

    # promote
    pr_p = sub.add_parser("promote", help="Promote a doc to Treasure (requires CONFIRM)")
    pr_p.add_argument("doc_id")
    pr_p.set_defaults(func=cmd_promote)

    # supersede
    ss_p = sub.add_parser("supersede", help="Mark old_id as superseded by new_id")
    ss_p.add_argument("old_id")
    ss_p.add_argument("new_id")
    ss_p.set_defaults(func=cmd_supersede)

    # gc
    gc_p = sub.add_parser("gc", help="Remove expired items")
    gc_p.add_argument("--dry-run", dest="dry_run", action="store_true")
    gc_p.set_defaults(func=cmd_gc)

    # compact
    cp_p = sub.add_parser("compact", help="Compact Working items into a Long-lived note")
    cp_p.add_argument("--session", default=None)
    cp_p.set_defaults(func=cmd_compact)

    # status
    st_p = sub.add_parser("status", help="Show store stats")
    st_p.set_defaults(func=cmd_status)

    # get
    ge_p = sub.add_parser("get", help="Get a doc by id")
    ge_p.add_argument("doc_id")
    ge_p.set_defaults(func=cmd_get)

    # list
    li_p = sub.add_parser("list", help="List docs")
    li_p.add_argument("--tier", choices=TIERS, default=None)
    li_p.add_argument("--session", default=None)
    li_p.set_defaults(func=cmd_list)

    # session new
    sn_p = sub.add_parser("session-new", help="Create a new session and print ids")
    sn_p.add_argument("description", nargs="?", default="")
    sn_p.set_defaults(func=cmd_session_new)

    # session update
    su_p = sub.add_parser("session-update", help="Update session state/description")
    su_p.add_argument("--session-id", dest="session_id", default=None)
    su_p.add_argument("--state", choices=["active", "wrapped"], default=None)
    su_p.add_argument("--description", default=None)
    su_p.set_defaults(func=cmd_session_update)

    return p


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
